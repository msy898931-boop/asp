TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# AI advisor (the "AI advisor" tab). A free Groq key turns it on; leave empty
# and the tab honestly says "not configured". Get one at console.groq.com.
# Groq and Gemini refuse to issue keys from some regions; Mistral's sign-up is
# not region-locked, so set ASTRA_ADVISOR_PROVIDER=mistral and MISTRAL_API_KEY
# if the other two cannot be created from where you are.
GROQ_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
# Which provider the advisor and the engine call: groq (default), gemini or
# mistral. The matching *_API_KEY above is the one that matters.
ASTRA_ADVISOR_PROVIDER=
# Override the model. For Mistral the default is mistral-small-latest, which
# the free Experiment tier refuses (HTTP 429, limit 0). The advisor then walks
# its free-tier fallbacks automatically (open-mistral-nemo, ministral-8b-latest).
# Set ASTRA_ADVISOR_MODELS to a comma-separated list to pin your own order.
ASTRA_ADVISOR_MODEL=
ASTRA_ADVISOR_MODELS=
# Selling the tool: paste a Stripe Payment Link to switch the free/pro gate on.
# Leave empty to keep everything free (the gate stays dormant).
ASTRA_UPGRADE_URL=
ASTRA_FREE_LEVELS=2
ASTRA_PRO_LEVELS=50
# Chat ids that are always Pro (the operator).
ASTRA_PRO_CHATS=
# Where ASTRA lives. Defaults to the deployed Render service and the current
# fork; set these to move a clone to a new host or repository.
#   ASTRA_URL   the service root, e.g. https://your-app.onrender.com
#   ASTRA_REPO  owner/repo, used for the APK fallback download link
ASTRA_URL=
ASTRA_REPO=
# Optional key for the phone app. Empty = open (the default, unchanged). Set it
# to require the key on every route but /api/v1/health; open the app once as
# https://host/?k=YOUR_KEY to store the cookie.
ASTRA_ACCESS_TOKEN=
