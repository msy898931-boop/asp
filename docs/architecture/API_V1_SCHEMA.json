{
  "$comment": "ASTRA backend/frontend API v1 - frozen contract (T17). Hand-maintained, machine-checked by tests/integration/test_mock_api_t19.py and scripts/mock_api.py --check. Routes not listed here are NOT part of the frozen frontend contract; /probability/latest and /signals/latest exist but are superseded by /analysis/latest. Every response body is enveloped as {api:'v1', schema:'1.0', data:...}. A missing dependency yields HTTP 503 with the flat error object {error:'true', code, message}; unknown routes yield 404; wrong method 405. T30 (2026-10-08): additive extension declaring every leaf field the real host serves (bridge/status, context, timeframes capability_impact/quality, risk proposal, research, governance, audit, shadow and analysis/history element shapes); additive only, no tag change. T31 (2026-10-20): declare `levels.targets`, the scaled-target ladder the host emits on /analysis/latest; additive only, no tag change.",
  "api": "v1",
  "schema": "1.0",
  "base": "http://127.0.0.1:8790/api/v1/",
  "loopback_only": true,
  "error_schema": {
    "type": "object",
    "required": ["error", "code", "message"],
    "properties": {
      "error": {"type": "string", "const": "true"},
      "code": {"type": "string"},
      "message": {"type": "string"}
    }
  },
  "endpoints": {
    "GET /api/v1/system/state": {
      "status": 200,
      "required": ["api", "schema", "data"],
      "data_required": ["mode", "shadow_only", "ready", "bridge_state", "startup_stage", "api", "schema"],
      "data_properties": {
        "mode": {"enum": ["STARTING", "RECOVERY", "NORMAL", "DEGRADED", "SHADOW", "PAUSED", "MANUAL", "EMERGENCY", "HALTED"]},
        "shadow_only": {"type": "boolean"},
        "ready": {"type": "boolean"},
        "bridge_state": {"type": "string"},
        "startup_stage": {"type": "string"},
        "api": {"const": "v1"},
        "schema": {"const": "1.0"}
      }
    },
    "GET /api/v1/health": {
      "status": 200,
      "required": ["api", "schema", "data"],
      "data_required": ["aggregate", "decision_grade_data", "degraded_reasons", "observed_at", "unknown_is_not_safe"],
      "data_properties": {
        "aggregate": {"type": "string"},
        "decision_grade_data": {"type": "boolean"},
        "degraded_reasons": {"type": "array"},
        "observed_at": {"type": ["integer", "null"]},
        "unknown_is_not_safe": {"const": true}
      }
    },
    "GET /api/v1/health/v1": {
      "status": 200,
      "required": ["api", "schema", "data"],
      "data_required": ["status", "bridge", "version", "uptime_sec"],
      "data_properties": {
        "status": {"enum": ["ok", "degraded", "offline"]},
        "bridge": {"enum": ["ok", "degraded", "offline"]},
        "version": {"const": "v1"},
        "uptime_sec": {"type": ["integer", "null"]}
      }
    },
    "GET /api/v1/timeframes": {
      "status": 200,
      "required": ["api", "schema", "data"],
      "data_type": "array",
      "element_required": ["timeframe", "observed", "has_closed_bar", "quality", "decision_grade", "freshness", "last_successful_update"],
      "element_properties": {
        "timeframe": {"enum": ["M1", "M5", "M15", "M30", "H1", "H4", "D1", "W1", "MN1"]},
        "observed": {"type": "boolean"},
        "has_closed_bar": {"type": "boolean"},
        "quality": {
          "type": "object",
          "required": ["state", "decision_grade"],
          "properties": {
            "state": {"type": "string"},
            "decision_grade": {"type": "boolean"}
          }
        },
        "decision_grade": {"type": "boolean"},
        "freshness": {
          "type": ["object", "null"],
          "required": ["state", "is_fresh", "last_update", "age_millis", "max_age_millis"],
          "properties": {
            "state": {"type": "string"},
            "is_fresh": {"type": "boolean"},
            "last_update": {"type": ["integer", "null"]},
            "age_millis": {"type": ["integer", "null"]},
            "max_age_millis": {"type": ["integer", "null"]}
          }
        },
        "last_successful_update": {"type": ["integer", "null"]},
        "last_closed_bar_open": {"type": ["integer", "null"]},
        "sequence": {"type": ["integer", "null"]},
        "capability_impact": {
          "type": "array",
          "element_required": ["capability", "impact", "reason"],
          "element_properties": {
            "capability": {"type": "string"},
            "impact": {"type": "string"},
            "reason": {"type": "string"}
          }
        }
      }
    },
