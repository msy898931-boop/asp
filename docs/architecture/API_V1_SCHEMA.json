      "status": 200,
      "required": ["api", "schema", "data"],
      "data_required": ["timeframe", "observed", "quality"],
      "data_properties": {
        "timeframe": {"type": "string"},
        "observed": {"type": "boolean"},
        "quality": {
          "type": "object",
          "required": ["state", "decision_grade"],
          "properties": {
