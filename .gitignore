# Build output (BLD-0002)
build/
out/
dist/
cmake-build-*/
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.exe
*.pdb

# Android app signing key (personal build; never commit a keystore)
android/astra.keystore
android/*.keystore

# Android launcher icons are regenerated by android/build.sh from the PWA artwork
android/app/src/main/res/mipmap-*/

# IDE / editor
.vscode/
.idea/
*.user
*.swp

# Runtime / local data (never commit local state or secrets).
# Anchored to the repository root: a bare `runtime/`, `data/`, or `logs/`
# would also match source directories such as src/runtime/ and src/data/.
/logs/
/data/
/runtime/
*.log
*.db
*.sqlite
*.sqlite3

# Local secrets and environment
.env
.env.*
*.secret
*.pem
*.key
secrets/

# Python bridge local environment (bundled runtime is a packaging artifact)
bridge/**/__pycache__/
bridge/**/.venv/
bridge/**/venv/
*.pyc

# OS noise
.DS_Store
Thumbs.db

# Agent scratch
.agent_tmp/
build/

# Coordination notify config (secret webhook URL — never commit)
coordination/notify/config
__pycache__/

# Large per-run corpus JSON (42 MB); the deterministic gzip is committed instead.
research/features_real/corpus/*.json
!research/features_real/corpus/real_corpus.json.gz
# T27 calibration reports are audit inputs; commit them (small).
!research/features_real/corpus/t27_report*.json

# Cached macro series (DXY/FRED) fetched by scripts/crossasset_lab.py
research/macro/
