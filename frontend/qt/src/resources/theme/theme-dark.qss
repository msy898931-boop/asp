/* ═══════════════════════════════════════════════════════════════════════════
   ASTRA — Dark Theme (QSS)
   Colors from ASTRA_VISUAL_IDENTITY.md
   ═══════════════════════════════════════════════════════════════════════════ */

/* ── Base ── */
QMainWindow, QWidget {
    background-color: #0A1628;
    color: #E8EEF5;
    font-family: "Inter", "Segoe UI", system-ui, sans-serif;
    font-size: 14px;
}

/* ── Cards ── */
QFrame[astraCard="true"] {
    background-color: #0F1F35;
    border: 1px solid #162A44;
    border-radius: 12px;
}

/* ── Buttons ── */
QPushButton {
    background: transparent;
    border: 1px solid #162A44;
    color: #8FA3BF;
    border-radius: 8px;
    padding: 8px 16px;
    min-width: 80px;
    font-weight: 500;
}

QPushButton:hover {
    background: #162A44;
    border-color: #4A90D9;
    color: #E8EEF5;
}

QPushButton:pressed {
    background: #4A90D9;
    border-color: #4A90D9;
    color: white;
}

QPushButton:disabled {
    background: transparent;
    border: 1px solid #162A44;
    color: #5A6B80;
}

/* Primary buttons (Save, Apply, Exit confirm) */
QPushButton[primary="true"] {
    background: #4A90D9;
    color: white;
    border: 1px solid #4A90D9;
}

QPushButton[primary="true"]:hover {
    background: #5AA0E9;
}

QPushButton[primary="true"]:pressed {
    background: #3A80C9;
}

/* Danger buttons */
QPushButton[danger="true"] {
    background: #D95A5A;
    color: white;
    border: 1px solid #D95A5A;
}

QPushButton[danger="true"]:hover {
    background: #E96A6A;
}

QPushButton[danger="true"]:pressed {
    background: #C94A4A;
}

/* ── Inputs ── */
QLineEdit, QComboBox, QSpinBox {
    background: #0F1F35;
    border: 1px solid #162A44;
    color: #E8EEF5;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 14px;
}

QLineEdit:hover, QComboBox:hover, QSpinBox:hover {
    border-color: #24384F;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus {
    border-color: #4A90D9;
}

QComboBox::drop-down {
    border: none;
    padding-right: 8px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #8FA3BF;
    margin-right: 8px;
}

QComboBox QAbstractItemView {
    background: #0F1F35;
    border: 1px solid #162A44;
    border-radius: 8px;
    selection-color: white;
    selection-background-color: #4A90D9;
}

/* ── Checkboxes ── */
QCheckBox {
    color: #E8EEF5;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #162A44;
    border-radius: 3px;
    background: #0F1F35;
}

QCheckBox::indicator:checked {
    background: #4A90D9;
    border-color: #4A90D9;
}

QCheckBox::indicator:hover {
    border-color: #4A90D9;
}

/* ── Scrollbars ── */
QScrollBar:vertical {
    background: #0A1628;
    width: 8px;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background: #162A44;
    border-radius: 4px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background: #24384F;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: #0A1628;
    height: 8px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal {
    background: #162A44;
    border-radius: 4px;
    min-width: 20px;
}

QScrollBar::handle:horizontal:hover {
    background: #24384F;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

/* ── Tables ── */
QTableWidget {
    background: #0F1F35;
    border: 1px solid #162A44;
    border-radius: 12px;
    gridline-color: #162A44;
}

QTableWidget::item {
    padding: 8px 12px;
    border-bottom: 1px solid #162A44;
}

QTableWidget::item:alternate {
    background: #0D1930;
}

QTableWidget::item:selected {
    background: #162A44;
    color: #E8EEF5;
}

QTableWidget::item:hover {
    background: #162A44;
}

QHeaderView::section {
    background: #162A44;
    color: #8FA3BF;
    padding: 10px 12px;
    border: none;
    border-bottom: 1px solid #24384F;
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
}

/* ── Tab Widget ── */
QTabWidget::pane {
    background: #0F1F35;
    border: 1px solid #162A44;
    border-radius: 12px;
}

QTabBar::tab {
    background: transparent;
    color: #8FA3BF;
    padding: 10px 16px;
    border-radius: 8px 8px 0 0;
    margin-right: 4px;
}

QTabBar::tab:selected {
    background: #162A44;
    color: #E8EEF5;
}

QTabBar::tab:hover:!selected {
    background: #162A44;
    color: #E8EEF5;
}

/* ── Tooltips ── */
QToolTip {
    background: #0F1F35;
    color: #E8EEF5;
    border: 1px solid #162A44;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 12px;
}

/* ── Dialogs ── */
QDialog {
    background: #0F1F35;
    border: 1px solid #162A44;
    border-radius: 16px;
}

/* ── Progress bars ── */
QProgressBar {
    background: #162A44;
    border: none;
    border-radius: 3px;
    height: 6px;
    text-align: center;
}

QProgressBar::chunk {
    background: #4A90D9;
    border-radius: 3px;
}

/* ── Keyboard focus ──
   A visible ring so keyboard users can see where focus is. Buttons, tabs and
   checkboxes had no focus style at all, so tabbing gave no feedback. */
QPushButton:focus {
    border-color: #5AA0E9;
    color: #E8EEF5;
}

QPushButton[primary="true"]:focus,
QPushButton[danger="true"]:focus {
    border-color: #E8EEF5;
}

QCheckBox:focus {
    color: #E8EEF5;
}

QCheckBox::indicator:focus {
    border-color: #4A90D9;
}

QTabBar::tab:focus {
    color: #E8EEF5;
    border: 1px solid #4A90D9;
    border-bottom: none;
}

/* ── Text selection ── */
QLineEdit::selection,
QTextEdit::selection,
QPlainTextEdit::selection {
    background: #4A90D9;
    color: #FFFFFF;
}
